{
  "name": "hotspot-poc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Git runner + storage PoC for the Git Hotspot Analyzer",
  "bin": { "hotspot": "dist/cli.js" },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --external:better-sqlite3 --outfile=dist/cli.js",
    "extract": "node --experimental-strip-types src/cli.ts extract",
    "dump": "node --experimental-strip-types src/cli.ts dump",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check",
    "format": "biome format --write ."
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "esbuild": "^0.21.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
